# ProcureAI Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Local or MongoDB Atlas URI (Falls back to embedded in-memory memory-store for demo if MongoDB is unavailable)
MONGODB_URI=mongodb://localhost:27017/procureai

# Redis / BullMQ (Optional: if not provided, in-process agent queue runner is used)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super_secret_procureai_enterprise_jwt_key_2026_x89f
JWT_EXPIRES_IN=7d

# AI LLM Provider (Optional - falls back to high-fidelity built-in autonomous heuristic AI agents)
OPENAI_API_KEY=
GEMINI_API_KEY=
